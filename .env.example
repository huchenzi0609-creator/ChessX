# Copy to .env.local; never put credentials in tracked files or chat.
CHESSX_API_KEY=
CHESSX_BASE_URL=
CHESSX_MODEL=
CHESSX_RESPONSE_FORMAT=json_schema
# Must match the configured model's documented tokenizer encoding.
CHESSX_TOKENIZER_NAME=cl100k_base
CHESSX_TOKENIZER_AGREEMENT=false
# Total generation deadline, with a separate connection deadline of at most 10s.
CHESSX_TIMEOUT_SECONDS=120
CHESSX_DATA_DIR=data
# Match the provider model's documented context capacity (input + completion).
CHESSX_CONTEXT_CAPACITY=16384
CHESSX_PROVIDER_PROFILE=generic

# Full private Markdown input budget; essential design text is never truncated.
CHESSX_CHARACTER_INPUT_LIMIT=8192
# Three-or-more-member ordinary dialogue: bounded race window, 1 disables speculation.
CHESSX_DIALOGUE_PARALLELISM=2
